# ---- School ERP mobile (Expo) environment ----
# Copy to .env for local dev. For EAS builds set the same values as EAS secrets /
# eas.json env (see docs/ANDROID.md and docs/IOS.md). No secrets belong here —
# only the public API address and the school selector.

# API base URL. Emulator: http://10.0.2.2:4000 (Android) / http://localhost:4000 (iOS sim).
# Physical device: your machine's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Which school this build serves (matches server `schools.slug`)
EXPO_PUBLIC_SCHOOL_SLUG=sunrise

# --- Optional build-time white-label overrides (win over server branding) ---
# EXPO_PUBLIC_SCHOOL_NAME=
# EXPO_PUBLIC_PRIMARY_COLOR=
# EXPO_PUBLIC_ACCENT_COLOR=

# --- Native identity (also configurable via EAS for per-school app variants) ---
EXPO_PUBLIC_APP_NAME=School ERP
EXPO_PUBLIC_APP_SLUG=school-erp
EXPO_PUBLIC_BUNDLE_ID=com.devzard.schoolerp
EXPO_PUBLIC_IOS_BUILD_NUMBER=1
EXPO_PUBLIC_ANDROID_VERSION_CODE=1

# EAS project id (from `eas init`) — enables push tokens + OTA updates
# EXPO_PUBLIC_EAS_PROJECT_ID=
