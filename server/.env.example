# ---- School ERP API environment (copy to .env and fill in; never commit real secrets) ----
PORT=4000
NODE_ENV=development

# PostgreSQL connection string (see docker-compose.yml for a local instance)
DATABASE_URL=postgres://erp:erp_password_change_me@localhost:5432/school_erp

# Long random strings in production (e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# File uploads (served only through permission-checked routes, never statically)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# CORS: comma-separated allowed origins, or * for local dev only
CORS_ORIGIN=*

# Expo push fan-out for broadcasts (best-effort). Requires expo push credentials server-side
# only if targeting FCM/APNs directly; the Expo push service needs no secret for basic use.
EXPO_PUSH_ENABLED=false

# Password assigned to seeded demo users by `npm run seed` (dev only)
DEMO_SEED_PASSWORD=School@123
